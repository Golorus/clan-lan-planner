# QA-Umgebung: kopieren nach deploy/qa/.env und ausfüllen (ANLEITUNG-QA.md). Nie die Werte der Live-App verwenden!

# eigene Subdomain, z. B. qa.planner.example.de (ohne https://)
DOMAIN=qa.planner.example.de

# Passwortschutz der Testseite (Traefik Basic Auth), erzeugen mit:  htpasswd -nbB qa 'DEIN-PASSWORT'
# In EINFACHEN Anführungszeichen lassen, sonst werden die $ im Hash ersetzt.
QA_BASIC_AUTH='qa:$2y$05$...'

# eigenes Sitzungs-Passwort, mindestens 32 Zeichen:  openssl rand -base64 48
NUXT_SESSION_PASSWORD=

# Link in Nachrichten
NUXT_APP_URL=https://qa.planner.example.de/
NUXT_PUBLIC_APP_NAME=Clan LAN Planner

# Optional: eigene Discord-TEST-Anwendung mit eigenem Bot auf einem Test-Server.
# Ohne diese Werte geht nur das Anmelden als Demo-Person; mit ihnen auch Discord-Login, Nachrichten und Knöpfe.
# NIE die Anwendung, den Bot oder den Server der Live-App eintragen: QA würde sonst echten Leuten schreiben.
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=
NUXT_OAUTH_DISCORD_REDIRECT_URL=https://qa.planner.example.de/auth/discord
NUXT_DISCORD_BOT_TOKEN=
NUXT_DISCORD_GUILD_ID=
NUXT_DISCORD_PUBLIC_KEY=
# dein Discord-Konto als Orga in QA (zusätzlich zur Demo-Orga)
NUXT_LEADER_DISCORD_ID=
