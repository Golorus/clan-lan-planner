# Kopieren nach .env und ausfüllen:  cp .env.example .env

# Deine Domain, z. B. planner.mein-clan.de (ohne https://)
DOMAIN=planner.example.de

# Zufälliges Passwort für die Sitzungs-Cookies, mindestens 32 Zeichen:  openssl rand -base64 48
NUXT_SESSION_PASSWORD=

# Discord-User-ID des Projektleiters (Discord: Einstellungen › Erweitert › Entwicklermodus, dann Rechtsklick auf dich › „User-ID kopieren“)
NUXT_LEADER_DISCORD_ID=

# Discord-Anwendung (https://discord.com/developers/applications) › OAuth2
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=
# genau so auch unter OAuth2 › Redirects eintragen
NUXT_OAUTH_DISCORD_REDIRECT_URL=https://planner.example.de/auth/discord

# dieselbe Anwendung › Bot › Token; Server-ID: Rechtsklick auf den Server › „Server-ID kopieren“
NUXT_DISCORD_BOT_TOKEN=
NUXT_DISCORD_GUILD_ID=

# Discord-Rolle für die Orga: wer sie auf deinem Server hat, kommt in /orga (Rechtsklick auf die Rolle › „Rollen-ID kopieren“).
# NUXT_LEADER_DISCORD_ID bleibt zusätzlich als Notzugang.
NUXT_DISCORD_ORGA_ROLE_ID=

# Clan-Rolle: wer sie auf deinem Server hat, darf ohne Freigabe mitmachen. Alle anderen fragen im Planner eine Freigabe an,
# ihre Kontaktperson bestätigt per Discord-Knopf (oder die Orga unter Orga › Teilnehmer). Leer = jedes Server-Mitglied. In /orga › Teilnehmer › Freigaben änderbar.
NUXT_DISCORD_MEMBER_ROLE_ID=

# Event-Rolle: der Bot gibt sie allen Zugesagten des aktuellen Events und nimmt sie bei Absage wieder weg.
# Nie dieselbe ID wie die Orga-Rolle (sonst gilt keine von beiden). Lässt sich auch in /orga setzen.
NUXT_DISCORD_EVENT_ROLE_ID=

# Name der App (Kopfzeile, Seitentitel, Test-Nachricht des Bots); leer = „Clan LAN Planner“
NUXT_PUBLIC_APP_NAME=
# Wie die Event-Rolle in den Texten heißt, z. B. „LAN-Rolle“; leer = „Event-Rolle“
NUXT_PUBLIC_EVENT_ROLE_NAME=

# dieselbe Anwendung › General Information › Public Key (prüft die Discord-Buttons in den Nachrichten)
NUXT_DISCORD_PUBLIC_KEY=

# Adresse der App für Links in Nachrichten; leer = https://DOMAIN/
NUXT_APP_URL=

# Impressum (/impressum): Name, ladungsfähige Anschrift und E-Mail der verantwortlichen Person
NUXT_PUBLIC_IMPRESSUM_NAME=
NUXT_PUBLIC_IMPRESSUM_STREET=
NUXT_PUBLIC_IMPRESSUM_CITY=
NUXT_PUBLIC_IMPRESSUM_EMAIL=
# optional, z. B. „Private, nicht-kommerzielle Planungsseite des Clans XY.“
NUXT_PUBLIC_IMPRESSUM_NOTE=
